/* ==========================================================================
   文章详情
   ========================================================================== */

.article {
  margin: 24rpx var(--gutter) 0;
  padding: 40rpx 36rpx 36rpx;
  background: var(--paper);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-1);
}

.article__kicker { display: flex; align-items: center; }
.article__kicker-text {
  font-size: 18rpx; letter-spacing: 3rpx; color: var(--ink-300);
  margin-left: 14rpx;
}

.article__title {
  margin-top: 20rpx;
  font-size: 46rpx; line-height: 1.42; font-weight: 700;
  color: var(--ink-900); letter-spacing: 0.5rpx;
}
.article__meta {
  margin-top: 18rpx;
  font-size: var(--fs-cap); color: var(--ink-500); line-height: 1.7;
}
.article__hr {
  height: 1rpx; background: var(--line-soft);
  margin: 30rpx 0 8rpx;
}

/* 正文：编号 + 段落的「手册条目」排版 */
.para { display: flex; padding: 20rpx 0; }
.para__idx {
  width: 52rpx; flex-shrink: 0;
  font-size: 20rpx; font-weight: 700; color: var(--brass-500);
  letter-spacing: 1rpx; padding-top: 10rpx;
}
.para__text {
  flex: 1; font-size: var(--fs-body); line-height: 1.9;
  color: var(--ink-700); letter-spacing: 0.3rpx;
}

.article__end {
  display: flex; align-items: center; justify-content: center;
  margin-top: 36rpx;
}
.article__end-text {
  font-size: 18rpx; letter-spacing: 4rpx; color: var(--ink-300);
  margin: 0 18rpx;
}

/* ---------- 相关服务 ---------- */
.cta {
  display: flex; align-items: center;
  margin: 24rpx var(--gutter) 0;
  padding: 28rpx 32rpx;
  border-radius: var(--r-lg);
  background: linear-gradient(140deg, #123026, #1B4235);
  box-shadow: var(--sh-2);
}
.cta--press { opacity: 0.95; }
.cta__main { flex: 1; min-width: 0; }
.cta__kicker { font-size: 18rpx; letter-spacing: 3rpx; color: rgba(255, 255, 255, 0.34); }
.cta__name {
  font-size: var(--fs-body); font-weight: 600; color: var(--paper);
  margin-top: 10rpx; line-height: 1.4;
}
.cta__meta { font-size: var(--fs-micro); color: rgba(255, 255, 255, 0.5); margin-top: 8rpx; }
.cta__btn {
  display: flex; align-items: center;
  height: 64rpx; padding: 0 24rpx;
  border-radius: var(--r-full);
  background: var(--brass-700);
  font-size: var(--fs-cap); font-weight: 600; color: var(--paper);
  flex-shrink: 0; margin-left: 20rpx;
}
.cta__btn-ico { margin-left: 4rpx; }
